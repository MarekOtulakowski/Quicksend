# Copy this file to .env before running `docker compose up` (compose
# loads .env automatically).

# Must be a domain whose DNS is managed by Cloudflare — Caddy proves
# ownership of it to Let's Encrypt via a DNS TXT record created
# through Cloudflare's API (see CLOUDFLARE_API_TOKEN below), not by
# answering an inbound HTTP request, so port 80 never needs to be
# open.
QUICKSEND_DOMAIN=quicksend.example.com

# A Cloudflare API token — not your account's Global API Key — scoped
# to just this one zone with "Zone / DNS / Edit" permission. Create
# one at https://dash.cloudflare.com/profile/api-tokens ("Edit zone
# DNS" template, restricted to the zone that owns QUICKSEND_DOMAIN).
# A scoped token limits what it can do if it's ever leaked; the
# Global API Key can edit every zone on the account and should never
# be used here.
CLOUDFLARE_API_TOKEN=
